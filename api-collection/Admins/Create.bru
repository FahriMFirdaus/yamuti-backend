meta {
  name: Create
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/admins
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:multipart-form {
  name: New Admin
  email: admin2@yamuti.org
  password: password
  role: admin
  nik: 3201020000000000
  no_hp: 081234567890
  status_pegawai: Aktif
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("admin_id", res.body.data.id);
    }
  }
}
