meta {
  name: Create
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/artikel
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "judul": "Artikel Baru",
    "konten": "Isi artikel",
    "kategori_id": "REPLACE_KATEGORI_ID",
    "status": "PUBLISHED"
  }
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("artikel_id", res.body.data.id);
    }
  }
}
