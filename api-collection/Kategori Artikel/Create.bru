meta {
  name: Create
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/kategori-artikel
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  {
    "nama": "Pendidikan"
  }
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("kategori_artikel_id", res.body.data.id);
    }
  }
}
