meta {
  name: Buat Donasi Baru
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/donasi
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nama_donatur": "Asep",
    "no_whatsapp": "081234567890",
    "gross_amount": 12000,
    "kampanye_id": "{{kampanye_id}}"
  }
}

vars:pre-request {
  kampanye_id: 9548fc3b-f96b-3324-b1c7-cdca71733aa4
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("donasi_id", res.body.data.id);
    }
  }
}
