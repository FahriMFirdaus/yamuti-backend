meta {
  name: Buat Janji Kunjungan
  type: http
  seq: 1
}
post {
  url: {{base_url}}/api/kunjungan
  body: json
  auth: none
}
body:json {
  {
    "tanggal_kunjungan": "2026-07-01",
    "jumlah_orang": 5,
    "tujuan": "Ingin bermain dan memberikan santunan",
    "catatan_tambahan": "Kami akan membawa makan siang"
  }
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("kunjungan_id", res.body.data.id);
    }
  }
}
