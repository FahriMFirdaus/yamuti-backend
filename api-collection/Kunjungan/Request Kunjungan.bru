meta {
  name: Buat Janji Kunjungan
  type: http
  seq: 1
}
post {
  url: {{base_url}}/api/kunjungan
  body: json
  auth: none
}
body:json {
  {
    "nama_tamu": "Budi Santoso",
    "no_whatsapp": "08123456789",
    "jumlah_pengunjung": 5,
    "maksud": "Silaturahmi dan berdonasi",
    "slot_waktu": "2026-06-25 10:00:00"
  }
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("kunjungan_id", res.body.data.id);
    }
  }
}
