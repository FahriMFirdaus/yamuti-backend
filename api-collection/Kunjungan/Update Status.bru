  token: {{token}}
}

body:json {
  {
    "status": "APPROVED",
    "catatan_admin": "Ditunggu kedatangannya jam 10 pagi"
  }
}

vars:pre-request {
  kunjungan_id: 019ef3eb-d2af-708a-b3ed-0f040d558cbe
}
