meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/inventaris
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nama_barang": "Laptop Operasional",
    "deskripsi": "Laptop untuk keperluan admin panti",
    "stok_sekarang": 5,
    "satuan": "Unit"
  }
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("inventaris_id", res.body.data.id);
    }
  }
}
