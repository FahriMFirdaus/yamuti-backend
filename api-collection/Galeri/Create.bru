meta {
  name: Create
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/galeri
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:multipart-form {
  judul: Dokumentasi Kegiatan
  deskripsi: Foto kegiatan belajar mengajar
  // file: (pilih file di UI)
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("galeri_id", res.body.data.id);
    }
  }
}
