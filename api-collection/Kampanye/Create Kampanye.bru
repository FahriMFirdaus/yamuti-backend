meta {
  name: Create Kampanye
  type: http
  seq: 2
}
post {
  url: {{base_url}}/api/kampanye
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:multipart-form {
  judul: Kampanye Ramadhan
  target_donasi: 50000000
}

script:post-response {
  if(res.status === 201 || res.status === 200) {
    if(res.body && res.body.data && res.body.data.id) {
      bru.setEnvVar("kampanye_id", res.body.data.id);
    }
  }
}
